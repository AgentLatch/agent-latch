# AgentLatch runtime: MySQL settings for  import-logs --mysql --env-file .env
# Copy this file to .env and fill in the passwords:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (Linux, macOS)
# .env is git-ignored. Never commit real passwords. Environment variables with the same names win.
# SQLite (--database FILE) needs no settings here.

# MySQL server you run yourself (for example in Docker). Use 127.0.0.1, not localhost.
AGENTLATCH_DB_HOST=127.0.0.1
AGENTLATCH_DB_PORT=3306
AGENTLATCH_DB_NAME=agentlatch

# Writer login: used by the importer to add events. INSERT on events, SELECT on schema_version.
AGENTLATCH_DB_USER=agentlatch_writer
AGENTLATCH_DB_PASSWORD=

# Migrator login: creates and updates the tables and the event_log view. Used only at start-up.
AGENTLATCH_DB_MIGRATE_USER=agentlatch_migrator
AGENTLATCH_DB_MIGRATE_PASSWORD=

# TLS: off for a MySQL server on this computer (the only option supported for now)
AGENTLATCH_DB_SSL=off
