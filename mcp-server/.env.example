# Copy this file to .env in this folder and fill in what you need:
#     cp .env.example .env
# .env is git-ignored. Never commit real tokens.
#
# Use a value in servers.json as ${NAME}. A server whose ${NAME} is empty is
# skipped with a message, so you only fill in tokens for the tools you use.

# Optional: in --http mode, agents must send "Authorization: Bearer <this token>".
MCP_GATEWAY_TOKEN=

# Optional: HTTP address (defaults shown).
MCP_GATEWAY_HOST=127.0.0.1
MCP_GATEWAY_PORT=8765

# GitHub server in servers.json (a fine-grained personal access token).
GITHUB_TOKEN=

# Slack tools (tools/slack_tools.py). Bot User OAuth Token with chat:write scope.
# Get it at https://api.slack.com/apps. See the top of slack_tools.py for steps.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#general

# ─── Model key for a real agent (examples/crewai_slack_demo.py) ───
# Paste your OpenAI key here and the agent will use it. Get one at
# https://platform.openai.com/api-keys  (starts with sk-).
# Only needed for the full live-agent run, not for the dashboard demo.
OPENAI_API_KEY=
# Optional: which model the agent uses (default gpt-4o-mini if left blank).
OPENAI_MODEL_NAME=gpt-4o-mini

# Add your own below and reference them from servers.json, for example:
# MY_SERVICE_API_KEY=
